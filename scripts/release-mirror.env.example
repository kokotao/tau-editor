# Copy to a protected file outside the repository (for example ~/.config/tau-editor/release-mirror.env).
# Do not commit real hosts, usernames, tokens, or private keys.

# SSH target whose web root serves https://note.lizipro.cn/taueditor/releases/
NOTE_MIRROR_HOST="release-sync@example.com"
NOTE_MIRROR_ROOT="/srv/www/taueditor/releases"
NOTE_MIRROR_BASE_URL="https://note.lizipro.cn/taueditor/releases"

# SourceForge project and SSH account. Configure the key in ~/.ssh/config or ssh-agent.
SOURCEFORGE_PROJECT="tau-editor"
SOURCEFORGE_USER="your-sourceforge-user"
SOURCEFORGE_HOST="frs.sourceforge.net"
SOURCEFORGE_PATH="tau-editor/releases"
