{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kokotao/tau-editor-themes/schemas/theme-v2.schema.json",
  "title": "Tau Editor Theme v2",
  "type": "object",
  "required": ["schemaVersion", "type", "id", "name", "version", "author", "license", "modes"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "type": { "const": "theme" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "author": { "type": "string", "minLength": 1, "maxLength": 128 },
    "license": { "type": "string", "minLength": 1, "maxLength": 64 },
    "defaultMode": { "enum": ["light", "dark"] },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "light": { "$ref": "#/$defs/mode" },
        "dark": { "$ref": "#/$defs/mode" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "mode": {
      "type": "object",
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/color" }
        },
        "monaco": { "type": "object" },
        "ui": { "$ref": "#/$defs/ui" }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "radius": {
          "oneOf": [
            { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
            {
              "type": "object",
              "properties": {
                "base": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "control": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "card": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "panel": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "tab": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "dialog": { "type": "number", "minimum": 0, "maximum": 24, "multipleOf": 0.5 },
                "badge": { "type": "number", "minimum": 0, "maximum": 999, "multipleOf": 0.5 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
